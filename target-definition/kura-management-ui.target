<target name="kura-management-ui-target-definition">
    <locations>
        <!--
            Single Maven location, no Profile location with absolute paths. All
            bundles are resolved from ~/.m2:
              - kura-bom: kura framework bundles (org.eclipse.kura.api, .core, …)
                that web2 depends on, by name.
              - target-platform-pde-deps: P2 third-party bundles (commons-io,
                fileupload2, eclipsesource.json, jakarta.servlet, gson, …)
                produced by monorepo's target-platform reficio.
              - p2.osgi.bundle:org.gwtproject.gwt-servlet-jakarta + gwtbootstrap3
                — ui-exclusive bundles produced by THIS sibling's target-platform
                reficio.

            Setup (once per fresh ~/.m2):
                mvn -f kura/target-platform/pom.xml install
                mvn -f kura-management-ui/target-platform/pom.xml install
            then any kura-management-ui reactor build resolves on any machine
            with no hardcoded paths.
        -->
        <location includeDependencyDepth="direct" includeDependencyScopes="compile,test"
            includeSource="true" missingManifest="ignore" type="Maven">

            <dependencies>
                <dependency>
                    <groupId>org.eclipse.kura</groupId>
                    <artifactId>kura-pde-deps</artifactId>
                    <version>6.0.0-SNAPSHOT</version>
                    <type>pom</type>
                </dependency>
                <dependency>
                    <groupId>org.eclipse.kura</groupId>
                    <artifactId>target-platform-pde-deps</artifactId>
                    <version>6.0.0-SNAPSHOT</version>
                    <type>pom</type>
                </dependency>
            </dependencies>

            <repositories>
                <repository>
                    <id>central</id>
                    <url>https://repo1.maven.org/maven2/</url>
                </repository>
            </repositories>
        </location>
    </locations>
</target>
