  <properties>
    <kura.basedir>${project.basedir}/..</kura.basedir>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>11</maven.compiler.release>
  </properties>
  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <resource>
        <directory>src/main/java</directory>
        <excludes>
          <exclude>**/*.java</exclude>
        </excludes>
      </resource>
      <resource>
        <directory>${project.basedir}</directory>
        <includes>
          <include>META-INF/**</include>
          <include>OSGI-INF/**</include>
          <include>about.html</include>
          <include>about_files/**</include>
        </includes>
        <excludes>
          <exclude>META-INF/MANIFEST.MF</exclude>
        </excludes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <executions>
          <execution>
            <id>prepare-handwritten-manifest</id>
            <phase>generate-resources</phase>
          </execution>
          <execution>
            <id>preserve-packaged-servlet-contract</id>
            <phase>generate-resources</phase>
            <goals><goal>run</goal></goals>
            <configuration>
              <target>
                <!-- The baseline bundle also required this contract, added by the old packager. -->
                <replace file="${project.build.directory}/osgi/MANIFEST.MF"
                         token="Require-Capability: osgi.ee;"
                         value="Require-Capability: osgi.contract;osgi.contract=JakartaServlet;filter:=&quot;(&amp;(osgi.contract=JakartaServlet)(version=6.0.0))&quot;,osgi.ee;"/>
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>copy-private-embedded-jars</id>
            <phase>generate-resources</phase>
            <goals>
              <goal>copy</goal>
            </goals>
            <configuration>
              <artifactItems>
                <artifactItem>
                  <groupId>org.gwtbootstrap3</groupId>
                  <artifactId>gwtbootstrap3</artifactId>
                  <version>1.0.1</version>
                  <outputDirectory>${project.build.outputDirectory}</outputDirectory>
                  <destFileName>gwtbootstrap3.jar</destFileName>
                </artifactItem>
                <artifactItem>
                  <groupId>org.gwtproject</groupId>
                  <artifactId>gwt-servlet-jakarta</artifactId>
                  <version>2.12.2</version>
                  <outputDirectory>${project.build.outputDirectory}</outputDirectory>
                  <destFileName>gwt-servlet-jakarta.jar</destFileName>
                </artifactItem>
                <artifactItem>
                  <groupId>org.gwtproject</groupId>
                  <artifactId>gwt-user</artifactId>
                  <version>2.12.2</version>
                  <outputDirectory>${project.build.outputDirectory}</outputDirectory>
                  <destFileName>gwt-user.jar</destFileName>
                </artifactItem>
              </artifactItems>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.felix</groupId>
        <artifactId>maven-bundle-plugin</artifactId>
        <extensions>true</extensions>
        <configuration>
          <instructions>
            <_include>${project.build.directory}/osgi/MANIFEST.MF</_include>
            <_nodefaultversion>true</_nodefaultversion>
            <_removeheaders>Include-Resource,Private-Package</_removeheaders>
            <Private-Package>!*</Private-Package>
            <Include-Resource>${project.build.outputDirectory}</Include-Resource>
            <Export-Package>!*</Export-Package>
          </instructions>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>gwt-maven-plugin</artifactId>
        <version>2.10.0</version>
        <executions>
          <execution>
            <goals>
              <goal>compile</goal>
              <goal>i18n</goal>
              <goal>generateAsync</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <style>OBF</style>
          <failOnError>true</failOnError>
          <extraJvmArgs>-Xmx2048M -Xss1024k -XX:+UseParallelGC</extraJvmArgs>
          <localWorkers>2</localWorkers>
          <runTarget>denali.html</runTarget>
          <i18nMessagesBundle>org.eclipse.kura.web.client.messages.Messages</i18nMessagesBundle>
          <i18nConstantsWithLookupBundle>org.eclipse.kura.web.client.messages.ValidationMessages</i18nConstantsWithLookupBundle>
          <webappDirectory>${project.build.directory}/gwt-webapp</webappDirectory>
          <sourceLevel>11</sourceLevel>
          <modules>
            <module>org.eclipse.kura.web.login</module>
            <module>org.eclipse.kura.web.denali</module>
          </modules>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-war-plugin</artifactId>
        <version>3.2.3</version>
        <executions>
          <execution>
            <phase>compile</phase>
            <goals>
              <goal>exploded</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <webappDirectory>${project.build.directory}/gwt-webapp</webappDirectory>
          <archive>
            <compress>false</compress>
            <manifestFile>META-INF/MANIFEST.MF</manifestFile>
          </archive>
          <webResources>
            <resource>
              <directory>src/main/resources/org/eclipse/kura/web/css</directory>
            </resource>
            <resource>
              <directory>src/main/resources/org/eclipse/kura/web/js</directory>
            </resource>
          </webResources>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <excludes>
            <exclude>**/org/eclipse/kura/web/client/**/*.java</exclude>
            <exclude>**/org/eclipse/kura/web/shared/service/*Async.java</exclude>
          </excludes>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <executions>
          <execution>
            <id>package-generated-web-resources</id>
            <phase>prepare-package</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.outputDirectory}/www</outputDirectory>
              <resources>
                <resource>
                  <directory>${project.build.directory}/gwt-webapp</directory>
                  <excludes>
                    <exclude>WEB-INF/**</exclude>
                    <exclude>**/gwt-unitCache/**</exclude>
                    <exclude>**/src/main/resources/**/js/*.js</exclude>
                    <exclude>**/src/main/resources/**/css/*.css</exclude>
                    <exclude>**/www/*.all.js</exclude>
                  </excludes>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
